---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import AdmissionsStepper from '../components/interactive/AdmissionsStepper';
import { getSiteContent } from '../lib/content-store';

const content = await getSiteContent();
const { admissions } = content;
const waUrl = `https://wa.me/${content.contact.whatsappNumber.replace(/\D/g, '')}?text=${encodeURIComponent(content.contact.whatsappMessage)}`;
---

<BaseLayout
  content={content}
  title="Admisiones"
  description={`Convocatoria vigente, requisitos de ingreso, documentación, fechas importantes y proceso de inscripción en ${content.brand.name}.`}
>
  <PageBanner
    eyebrow="Ingreso Universitario"
    title="Admisiones"
    subtitle="Toda la información clara y transparente para integrarte a nuestra comunidad universitaria."
    breadcrumb="Admisiones"
  />

  <!-- Convocatoria Vigente Banner Card -->
  <section class="relative -mt-10 z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      data-reveal="scale"
      class="rounded-3xl bg-white shadow-[0_24px_60px_-24px_rgba(12,30,53,0.18)] border border-[#C69D48]/40 p-7 sm:p-10 flex flex-col lg:flex-row lg:items-center justify-between gap-8"
    >
      <div class="space-y-3 max-w-3xl">
        <div class="flex flex-wrap items-center gap-3">
          <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            {admissions.announcementStatus}
          </span>
          <span class="px-3.5 py-1 rounded-full text-xs font-semibold bg-[#FAF8F4] text-[#0C1E35] border border-[#0C1E35]/10">
            {admissions.announcementPeriod}
          </span>
        </div>
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-[#0C1E35]">
          {admissions.announcementTitle}
        </h2>
        <p class="text-sm sm:text-base text-[#52647B] leading-relaxed">
          {admissions.announcementSummary}
        </p>
      </div>

      <div class="flex flex-wrap lg:flex-col gap-3 shrink-0">
        <a
          href={admissions.announcementPdfUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-magnetic="0.14"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full text-xs uppercase tracking-[0.14em] btn-primary"
        >
          <span>Descargar Convocatoria PDF</span>
        </a>
        <a
          href="/contacto"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full text-xs uppercase tracking-[0.14em] btn-gold"
        >
          <span>Solicitar Información</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Requisitos de Ingreso -->
  <section class="py-16 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div class="max-w-2xl space-y-2" data-reveal>
        <p class="text-xs font-semibold uppercase tracking-[0.22em]" style="color: var(--brand-accent);">
          Criterios Académicos
        </p>
        <h2 class="font-display text-3xl sm:text-5xl font-bold text-[#0C1E35]">
          Requisitos de Ingreso
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {admissions.requirements.map((req, idx) => (
          <div
            data-spotlight
            data-reveal
            data-delay={String(idx * 70)}
            class="spotlight-card rounded-2xl p-6 flex items-start gap-4"
          >
            <span class="w-9 h-9 rounded-xl bg-[#0C1E35] text-[#E6C77B] font-bold text-sm flex items-center justify-center shrink-0">
              0{idx + 1}
            </span>
            <p class="text-sm sm:text-[15px] text-[#132238] leading-relaxed pt-1">{req}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Proceso de Inscripción y Checklist Interactivo de Documentación -->
  <section class="py-16 sm:py-24 bg-white border-y border-[#0C1E35]/8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <AdmissionsStepper
        client:visible
        steps={admissions.enrollmentSteps}
        documents={admissions.documents}
      />
    </div>
  </section>

  <!-- Fechas Importantes -->
  <section class="py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="max-w-2xl space-y-2" data-reveal>
        <p class="text-xs font-semibold uppercase tracking-[0.22em]" style="color: var(--brand-accent);">
          Cronograma Oficial
        </p>
        <h2 class="font-display text-3xl sm:text-5xl font-bold text-[#0C1E35]">
          Fechas Importantes
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-5">
        {admissions.importantDates.map((item, idx) => (
          <article
            data-spotlight
            data-reveal
            data-delay={String(idx * 75)}
            class={`spotlight-card rounded-3xl p-6 flex flex-col justify-between gap-4 ${
              item.status === 'active' ? 'ring-2 ring-[#C69D48] bg-[#FFFDF8]!' : ''
            }`}
          >
            <div class="space-y-3">
              <span
                class={`inline-flex px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider ${
                  item.status === 'active'
                    ? 'bg-emerald-100 text-emerald-800'
                    : item.status === 'completed'
                    ? 'bg-slate-200 text-slate-600'
                    : 'bg-[#0C1E35]/8 text-[#0C1E35]'
                }`}
              >
                {item.status === 'active' ? 'En curso' : item.status === 'completed' ? 'Concluido' : 'Próximo'}
              </span>
              <p class="text-xs font-bold uppercase tracking-wider text-[#C69D48]">{item.date}</p>
              <h3 class="font-display text-xl font-bold text-[#0C1E35] leading-snug">{item.title}</h3>
            </div>
            <p class="text-xs text-[#52647B] leading-relaxed">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Información de Costos (Editable / Opcional desde Admin) -->
  <section class="pb-20 sm:pb-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        data-reveal="scale"
        class="rounded-[2rem] bg-[#0C1E35] text-white p-8 sm:p-12 space-y-8 relative overflow-hidden"
      >
        <div class="pointer-events-none absolute -top-24 -right-24 w-80 h-80 rounded-full opacity-15 blur-3xl" style="background: var(--brand-accent);"></div>

        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 relative z-10">
          <div class="space-y-2 max-w-2xl">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#E6C77B]">
              Inversión Educativa
            </p>
            <h2 class="font-display text-3xl sm:text-4xl font-bold">
              Información de Costos y Becas
            </h2>
            <p class="text-sm text-white/75 leading-relaxed">{admissions.costsNote}</p>
          </div>

          <div class="flex flex-wrap gap-3">
            <a href="/contacto" data-magnetic="0.14" class="px-6 py-3 rounded-full text-xs uppercase tracking-[0.14em] btn-gold">
              Solicitar Información
            </a>
            <a href={waUrl} target="_blank" rel="noopener noreferrer" class="px-6 py-3 rounded-full text-xs uppercase tracking-[0.14em] font-semibold bg-emerald-600 hover:bg-emerald-500 text-white transition-colors">
              Consultar por WhatsApp
            </a>
          </div>
        </div>

        {admissions.costsAvailable && admissions.costs.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-3 gap-5 relative z-10">
            {admissions.costs.map((cost) => (
              <div data-spotlight class="spotlight-card-dark rounded-2xl p-6 space-y-2">
                <p class="text-xs uppercase tracking-wider text-white/60">{cost.frequency}</p>
                <p class="font-display text-3xl font-bold text-[#E6C77B]">{cost.amount}</p>
                <p class="text-sm font-medium text-white">{cost.concept}</p>
              </div>
            ))}
          </div>
        ) : (
          <div class="p-6 rounded-2xl bg-white/8 border border-white/15 text-sm text-white/80 relative z-10">
            La tabla de cuotas para el próximo ciclo se encuentra en proceso de publicación. Solicita orientación personalizada con nuestro equipo de Admisiones.
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
