---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import CurriculumExplorer from '../components/interactive/CurriculumExplorer';
import { getSiteContent } from '../lib/content-store';

const content = await getSiteContent();
const { program } = content;
const planDoc = content.academicLife.documents.find((d) => d.category === 'Plan de Estudios');
---

<BaseLayout
  content={content}
  title="Oferta Educativa"
  description={`${program.name} en ${content.brand.name}. Conoce perfil de ingreso, egreso, plan de estudios y campo laboral.`}
>
  <PageBanner
    eyebrow="Oferta Educativa"
    title={program.name}
    subtitle={program.generalDescription}
    breadcrumb="Oferta Educativa"
  />

  <!-- Ficha Técnica Rápida: Duración, Modalidad, Horario y Grado Académico -->
  <section class="relative -mt-8 z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      data-reveal="scale"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 p-6 sm:p-7 rounded-3xl bg-white shadow-[0_24px_60px_-24px_rgba(12,30,53,0.16)] border border-[#0C1E35]/10"
    >
      <div class="p-4 rounded-2xl bg-[#FAF8F4] space-y-1">
        <p class="text-[11px] uppercase tracking-[0.18em] font-semibold text-[#C69D48]">Grado Académico</p>
        <p class="text-sm font-bold text-[#0C1E35] leading-snug">{program.academicDegree}</p>
      </div>
      <div class="p-4 rounded-2xl bg-[#FAF8F4] space-y-1">
        <p class="text-[11px] uppercase tracking-[0.18em] font-semibold text-[#C69D48]">Duración</p>
        <p class="text-sm font-bold text-[#0C1E35]">{program.duration}</p>
      </div>
      <div class="p-4 rounded-2xl bg-[#FAF8F4] space-y-1">
        <p class="text-[11px] uppercase tracking-[0.18em] font-semibold text-[#C69D48]">Modalidad</p>
        <p class="text-sm font-bold text-[#0C1E35]">{program.modality}</p>
      </div>
      <div class="p-4 rounded-2xl bg-[#FAF8F4] space-y-1">
        <p class="text-[11px] uppercase tracking-[0.18em] font-semibold text-[#C69D48]">Horario y Registro</p>
        <p class="text-sm font-bold text-[#0C1E35]">{program.schedule}</p>
      </div>
    </div>
  </section>

  <!-- Objetivo del Programa Educativo -->
  <section class="py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 space-y-6" data-reveal="left">
          <p class="text-xs font-semibold uppercase tracking-[0.22em]" style="color: var(--brand-accent);">
            Propósito Formativo
          </p>
          <h2 class="font-display text-3xl sm:text-5xl font-bold text-[#0C1E35] leading-tight">
            Objetivo del Programa Educativo
          </h2>
          <p class="text-base sm:text-lg text-[#52647B] leading-relaxed">
            {program.objective}
          </p>
          <div class="p-4 rounded-2xl bg-white border border-[#C69D48]/35 text-xs text-[#52647B]">
            <strong class="text-[#0C1E35]">Referencia académica:</strong> {program.rvoe}
          </div>
        </div>

        <div class="lg:col-span-6" data-reveal="right">
          <div class="img-zoom-frame rounded-3xl overflow-hidden shadow-2xl border border-[#0C1E35]/10 aspect-[4/3]">
            <img src={program.heroImage} alt={program.name} class="w-full h-full object-cover" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Perfil de Ingreso y Perfil de Egreso -->
  <section class="py-16 sm:py-24 bg-white border-y border-[#0C1E35]/8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Perfil de Ingreso -->
        <article data-spotlight data-reveal="left" class="spotlight-card rounded-3xl p-8 sm:p-10 space-y-6">
          <div class="space-y-2">
            <span class="inline-flex px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-[#0C1E35]/8 text-[#0C1E35]">
              Aspirantes
            </span>
            <h2 class="font-display text-3xl sm:text-4xl font-bold text-[#0C1E35]">Perfil de Ingreso</h2>
          </div>
          <ul class="space-y-4">
            {program.entryProfile.map((item, idx) => (
              <li class="flex items-start gap-3.5 text-sm sm:text-[15px] text-[#52647B] leading-relaxed">
                <span class="mt-0.5 w-6 h-6 rounded-full bg-[#FAF8F4] border border-[#C69D48]/50 text-[#0C1E35] text-xs font-bold flex items-center justify-center shrink-0">
                  {idx + 1}
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>

        <!-- Perfil de Egreso -->
        <article data-spotlight data-reveal="right" class="spotlight-card rounded-3xl p-8 sm:p-10 space-y-6 bg-[#0C1E35]! text-white border-[#C69D48]/30!">
          <div class="space-y-2">
            <span class="inline-flex px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-[#C69D48]/25 text-[#F5DFAA]">
              Competencias Profesionales
            </span>
            <h2 class="font-display text-3xl sm:text-4xl font-bold text-white">Perfil de Egreso</h2>
          </div>
          <ul class="space-y-4">
            {program.exitProfile.map((item) => (
              <li class="flex items-start gap-3.5 text-sm sm:text-[15px] text-white/82 leading-relaxed">
                <span class="mt-1 w-5 h-5 rounded-full bg-[#C69D48] text-[#071323] text-xs font-bold flex items-center justify-center shrink-0">
                  ✓
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- Plan de Estudios Interactivo -->
  <section id="plan-de-estudios" class="py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div class="max-w-2xl space-y-3" data-reveal>
        <p class="text-xs font-semibold uppercase tracking-[0.22em]" style="color: var(--brand-accent);">
          Mapa Curricular Interactivo
        </p>
        <h2 class="font-display text-3xl sm:text-5xl font-bold text-[#0C1E35]">
          Plan de Estudios
        </h2>
        <p class="text-sm sm:text-base text-[#52647B]">
          Explora las asignaturas semestre por semestre y descarga la versión oficial en PDF.
        </p>
      </div>

      <CurriculumExplorer
        client:visible
        curriculum={program.curriculum}
        pdfUrl={planDoc?.fileUrl || '/docs/plan-de-estudios-lige.pdf'}
      />
    </div>
  </section>

  <!-- Campo Laboral -->
  <section class="py-16 sm:py-24 bg-white border-t border-[#0C1E35]/8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6" data-reveal>
        <div class="space-y-3 max-w-2xl">
          <p class="text-xs font-semibold uppercase tracking-[0.22em]" style="color: var(--brand-accent);">
            Proyección Profesional
          </p>
          <h2 class="font-display text-3xl sm:text-5xl font-bold text-[#0C1E35]">
            Campo Laboral
          </h2>
        </div>
        <a
          href="/admisiones"
          data-magnetic="0.14"
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full text-xs uppercase tracking-[0.14em] btn-gold w-fit"
        >
          <span>Iniciar Proceso de Admisión →</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {program.careerField.map((field, idx) => (
          <article
            data-spotlight
            data-reveal
            data-delay={String(idx * 60)}
            class="spotlight-card rounded-3xl p-7 space-y-3"
          >
            <span class="inline-block w-8 h-1 rounded-full" style="background: var(--brand-accent);"></span>
            <h3 class="font-display text-2xl font-bold text-[#0C1E35]">{field.area}</h3>
            <p class="text-sm text-[#52647B] leading-relaxed">{field.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
