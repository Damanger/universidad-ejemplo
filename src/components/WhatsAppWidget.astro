---
import type { SiteContent } from '../types/content';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const cleanPhone = content.contact.whatsappNumber.replace(/\D/g, '');
const waUrl = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(content.contact.whatsappMessage)}`;
---

<div class="fixed bottom-6 right-5 sm:right-7 z-40 group flex items-center gap-3">
  <!-- Expandable Tooltip Pill -->
  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="hidden sm:flex items-center gap-2 px-4 py-2.5 rounded-full bg-[#0C1E35] text-white text-xs font-medium shadow-xl border border-[#C69D48]/35 opacity-0 translate-x-3 pointer-events-none group-hover:opacity-100 group-hover:translate-x-0 group-hover:pointer-events-auto transition-all duration-300"
  >
    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
    <span>¿Dudas sobre admisiones? Escríbenos</span>
  </a>

  <!-- Floating WhatsApp Button -->
  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contactar por WhatsApp"
    data-magnetic="0.2"
    class="relative flex items-center justify-center w-14 h-14 rounded-full bg-[#16A34A] text-white shadow-[0_12px_28px_-6px_rgba(22,163,74,0.6)] hover:bg-[#15803D] transition-colors duration-300"
  >
    <span class="whatsapp-ring absolute inset-0 rounded-full bg-[#22C55E] -z-10"></span>
    <svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M20.52 3.48A11.86 11.86 0 0 0 12.06 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.15 1.59 5.96L0 24l6.32-1.66a11.86 11.86 0 0 0 5.74 1.46h.01c6.56 0 11.9-5.34 11.9-11.9 0-3.18-1.24-6.17-3.45-8.42ZM12.07 21.8h-.01a9.87 9.87 0 0 1-5.04-1.38l-.36-.22-3.75.99 1-3.66-.24-.38a9.84 9.84 0 0 1-1.51-5.25c0-5.45 4.44-9.89 9.9-9.89 2.64 0 5.13 1.03 7 2.9a9.82 9.82 0 0 1 2.9 7c0 5.45-4.44 9.89-9.89 9.89Zm5.43-7.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.48-1.77-1.66-2.07-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.08-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.08.15.2 2.1 3.21 5.08 4.5.71.3 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35Z"/>
    </svg>
  </a>
</div>
