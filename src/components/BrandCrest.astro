---
interface Props {
  logoUrl?: string;
  shortName: string;
  size?: 'sm' | 'md' | 'lg';
  light?: boolean;
}

const { logoUrl, shortName, size = 'md', light = false } = Astro.props;

const dims = {
  sm: 'h-9 w-9',
  md: 'h-11 w-11',
  lg: 'h-16 w-16',
}[size];
---

{logoUrl ? (
  <img
    src={logoUrl}
    alt={`Logotipo de ${shortName}`}
    class={`${dims} object-contain rounded-lg transition-transform duration-500 hover:scale-105`}
  />
) : (
  <div
    class={`${dims} relative flex items-center justify-center rounded-xl transition-transform duration-500 group-hover:scale-105`}
    style={light ? 'background: rgba(255,255,255,0.08); border: 1px solid rgba(198,157,72,0.45);' : 'background: var(--brand-primary); border: 1px solid rgba(198,157,72,0.5);'}
    aria-hidden="true"
  >
    <svg viewBox="0 0 48 48" class="w-4/5 h-4/5" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Institutional Shield -->
      <path
        class="crest-path"
        d="M24 5L39 10.5V23.5C39 32.8 32.6 39.8 24 43C15.4 39.8 9 32.8 9 23.5V10.5L24 5Z"
        stroke="var(--brand-accent)"
        stroke-width="1.8"
      />
      <!-- Oaxaca Architectural Arch -->
      <path
        class="crest-path"
        d="M16.5 31V21.5C16.5 17.35 19.85 14 24 14C28.15 14 31.5 17.35 31.5 21.5V31"
        stroke="#FFFFFF"
        stroke-width="1.7"
        stroke-linecap="round"
      />
      <!-- Open Book & Rising Sun -->
      <path
        d="M15 31.5C18.5 30.2 21.5 30.6 24 32.3C26.5 30.6 29.5 30.2 33 31.5"
        stroke="var(--brand-accent)"
        stroke-width="1.8"
        stroke-linecap="round"
      />
      <circle cx="24" cy="21" r="2.6" fill="var(--brand-accent)" />
    </svg>
  </div>
)}
